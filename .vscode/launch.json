{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Run ZenMonitor",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Tailwind CSS Watch",
      "program": "dotnet",
      "args": [
        "watch",
        "--project",
        "${workspaceFolder}/src/ZenMonitor/ZenMonitor.csproj",
        "run",
        "--",
        "-n"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}