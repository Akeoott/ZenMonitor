{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Run",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/ZenMonitor/ZenMonitor.csproj",
        "--",
        "-f"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": ".NET Run (debug)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/ZenMonitor/ZenMonitor.csproj",
        "--",
        "-f",
        "-v",
        "d"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}