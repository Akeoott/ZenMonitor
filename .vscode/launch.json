{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET DevConfig (GUI)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Tailwind CSS Watch",
      "program": "dotnet",
      "args": [
        "watch",
        "run",
        "debug",
        "--launch-profile",
        "http"
      ],
      "cwd": "${workspaceFolder}/ZenMonitor.Gui",
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": ".NET (GUI)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/ZenMonitor/bin/Debug/net10.0/ZenMonitor.dll",
      "args": [
        "-r",
        "gui"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": ".NET (TUI)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/ZenMonitor/bin/Debug/net10.0/ZenMonitor.dll",
      "args": [
        "-r",
        "tui"
      ],
      "cwd": "${workspaceFolder}"
    }
  ]
}