<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.7" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core library references — point to standalone ZenMonitor.Core for local testing.
         To switch to NuGet packages when Core is released, replace these ProjectReference
         lines with PackageReference entries:
           <PackageReference Include="ZenMonitor.Core" Version="..." />
           <PackageReference Include="ZenMonitor.Core.Hosting" Version="..." />
           <PackageReference Include="ZenMonitor.Core.Linux" Version="..." />
    -->
    <ProjectReference Include="..\..\ZenMonitor.Core\src\ZenMonitor.Core\ZenMonitor.Core.csproj" />
    <ProjectReference Include="..\..\ZenMonitor.Core\src\ZenMonitor.Core.Hosting\ZenMonitor.Core.Hosting.csproj" />
    <ProjectReference Include="..\ZenMonitor.Cli\ZenMonitor.Cli.csproj" />
    <ProjectReference Include="..\ZenMonitor.Tui\ZenMonitor.Tui.csproj" />
    <ProjectReference Include="..\ZenMonitor.Gui\ZenMonitor.Gui.csproj" />
  </ItemGroup>

</Project>