<sukiUi:SukiWindow xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                   xmlns:vm="clr-namespace:ZenMonitor.Desktop.ViewModels"
                   MinWidth="800" MinHeight="450"
                   CanResize="True"
                   WindowState="Normal"
                   x:DataType="vm:MainWindowModel"
                   x:Class="ZenMonitor.Desktop.Views.MainWindow"
                   Icon="/Assets/avalonia-logo.ico"
                   Title="ZenMonitor"
                   Background="{DynamicResource SukiBackground}"
                   BackgroundTransitionsEnabled="True"
                   BackgroundAnimationEnabled="true">

  <DockPanel>
    <Border DockPanel.Dock="Left" Width="220">
      <StackPanel Margin="12" Spacing="4">
        <Button Command="{Binding NavigateHomeCommand}"
                Background="{Binding HomeButtonBackground}"
                BorderThickness="1"
                HorizontalContentAlignment="Left"
                Height="40"
                Margin="0">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="&#x1F3E0;" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="Home" FontSize="14" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Command="{Binding NavigateSettingsCommand}"
                Background="{Binding SettingsButtonBackground}"
                BorderThickness="1"
                HorizontalContentAlignment="Left"
                Height="40">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="&#x2699;" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="Settings" FontSize="14" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <ContentControl Content="{Binding CurrentViewModel}" Margin="16" />
  </DockPanel>

</sukiUi:SukiWindow>