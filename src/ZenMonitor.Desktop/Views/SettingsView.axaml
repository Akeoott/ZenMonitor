<UserControl
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d"
  x:Class="ZenMonitor.Desktop.Views.SettingsView"
  x:DataType="vm:SettingsViewModel"
  xmlns="https://github.com/avaloniaui"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helper="clr-namespace:ZenMonitor.Desktop.Helper"
  xmlns:local="clr-namespace:SukiUI.Enums;assembly=SukiUI"
  xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
  xmlns:vm="clr-namespace:ZenMonitor.Desktop.ViewModels"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <helper:EnumToBoolConverter x:Key="EnumToBoolConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="WrapPanel &gt; ToggleButton">
      <Setter Property="Height" Value="35" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="{Binding !IsChecked, RelativeSource={RelativeSource Self}}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

    <StackPanel>

      <sukiUi:GlassCard
        HorizontalAlignment="Stretch"
        Margin="20,20,20,0"
        MaxWidth="1000"
        VerticalAlignment="Top">

        <sukiUi:GroupBox Header="Config">
          <StackPanel Margin="10" Spacing="25" />
        </sukiUi:GroupBox>
      </sukiUi:GlassCard>

      <sukiUi:GlassCard
        HorizontalAlignment="Stretch"
        Margin="20,20,20,0"
        MaxWidth="1000"
        VerticalAlignment="Top">

        <sukiUi:GroupBox Header="Theme Customization">
          <StackPanel Margin="10" Spacing="25">

            <StackPanel Spacing="10">
              <StackPanel
                Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center">
                <materialIcons:MaterialIcon
                  Foreground="{DynamicResource SukiText}"
                  Height="20"
                  Kind="Brightness4"
                  Width="20" />
                <TextBlock
                  FontSize="15"
                  FontWeight="DemiBold"
                  Text="Appearance Mode"
                  VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock
                Classes="Secondary"
                FontSize="12"
                Margin="32,0,0,5"
                Text="Switch between light and dark interface styles." />
              <Button
                Classes="Primary"
                Command="{Binding ToggleThemeCommand}"
                Content="Toggle Dark / Light"
                HorizontalAlignment="Left"
                Margin="32,0,0,0" />
            </StackPanel>

            <Separator
              Background="{DynamicResource SukiBorderBrush}"
              Height="1"
              Opacity="0.4" />

            <StackPanel Spacing="10">
              <StackPanel
                Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center">
                <materialIcons:MaterialIcon
                  Foreground="{DynamicResource SukiText}"
                  Height="20"
                  Kind="Color"
                  Width="20" />
                <TextBlock
                  FontSize="15"
                  FontWeight="DemiBold"
                  Text="Accent Color"
                  VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock
                Classes="Secondary"
                FontSize="12"
                Margin="32,0,0,5"
                Text="Select a primary accent tone for highlights and active controls." />

              <WrapPanel HorizontalAlignment="Left" Margin="32,0,0,0">
                <ToggleButton
                  Command="{Binding ChangeColorThemeCommand}"
                  CommandParameter="{x:Static local:SukiColor.Blue}"
                  Content="Blue"
                  IsChecked="{Binding ActiveColor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:SukiColor.Blue}, Mode=OneWay}" />
                <ToggleButton
                  Command="{Binding ChangeColorThemeCommand}"
                  CommandParameter="{x:Static local:SukiColor.Red}"
                  Content="Red"
                  IsChecked="{Binding ActiveColor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:SukiColor.Red}, Mode=OneWay}" />
                <ToggleButton
                  Command="{Binding ChangeColorThemeCommand}"
                  CommandParameter="{x:Static local:SukiColor.Green}"
                  Content="Green"
                  IsChecked="{Binding ActiveColor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:SukiColor.Green}, Mode=OneWay}" />
                <ToggleButton
                  Command="{Binding ChangeColorThemeCommand}"
                  CommandParameter="{x:Static local:SukiColor.Orange}"
                  Content="Orange"
                  IsChecked="{Binding ActiveColor, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:SukiColor.Orange}, Mode=OneWay}" />
              </WrapPanel>
            </StackPanel>

            <Separator
              Background="{DynamicResource SukiBorderBrush}"
              Height="1"
              Opacity="0.4" />

            <StackPanel Spacing="10">
              <StackPanel
                Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center">
                <materialIcons:MaterialIcon
                  Foreground="{DynamicResource SukiText}"
                  Height="20"
                  Kind="Theme"
                  Width="20" />
                <TextBlock
                  FontSize="15"
                  FontWeight="DemiBold"
                  Text="Background Effects"
                  VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock
                Classes="Secondary"
                FontSize="12"
                Margin="32,0,0,5"
                Text="Choose the rendering style and gradient effects for the window canvas." />

              <WrapPanel HorizontalAlignment="Left" Margin="32,0,0,0">
                <ToggleButton
                  Command="{Binding ChangeBackgroundThemeCommand}"
                  CommandParameter="{x:Static local:SukiBackgroundStyle.Flat}"
                  Content="Flat"
                  IsChecked="{Binding CurrentBackgroundStyle, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:SukiBackgroundStyle.Flat}, Mode=OneWay}" />
                <ToggleButton
                  Command="{Binding ChangeBackgroundThemeCommand}"
                  CommandParameter="{x:Static local:SukiBackgroundStyle.Gradient}"
                  Content="Gradient"
                  IsChecked="{Binding CurrentBackgroundStyle, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:SukiBackgroundStyle.Gradient}, Mode=OneWay}" />
                <ToggleButton
                  Command="{Binding ChangeBackgroundThemeCommand}"
                  CommandParameter="{x:Static local:SukiBackgroundStyle.GradientDarker}"
                  Content="Gradient Darker"
                  IsChecked="{Binding CurrentBackgroundStyle, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:SukiBackgroundStyle.GradientDarker}, Mode=OneWay}" />
                <ToggleButton
                  Command="{Binding ChangeBackgroundThemeCommand}"
                  CommandParameter="{x:Static local:SukiBackgroundStyle.GradientSoft}"
                  Content="Gradient Soft"
                  IsChecked="{Binding CurrentBackgroundStyle, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:SukiBackgroundStyle.GradientSoft}, Mode=OneWay}" />
                <ToggleButton
                  Command="{Binding ChangeBackgroundThemeCommand}"
                  CommandParameter="{x:Static local:SukiBackgroundStyle.Bubble}"
                  Content="Bubble"
                  IsChecked="{Binding CurrentBackgroundStyle, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static local:SukiBackgroundStyle.Bubble}, Mode=OneWay}" />
              </WrapPanel>
            </StackPanel>

          </StackPanel>
        </sukiUi:GroupBox>

      </sukiUi:GlassCard>
    </StackPanel>

  </ScrollViewer>
</UserControl>